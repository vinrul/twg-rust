ENVIROMENT=development
DB_DRIVER=postgres
DB_SOURCE=postgresql://twg_baseline:twg_baseline_local@127.0.0.1:55432/twg_baseline?sslmode=disable
HTTP_SERVER_ADDRESS=127.0.0.1:8010

TOKEN_SYMMETRIC_KEY=0123456789abcdef0123456789abcdef
ACCESS_TOKEN_DURATION=24h
REFRESH_TOKEN_DURATION=168h
SINGLE_DEVICE_ROLES=admin,admin_satker

CHANNEL=twg-baseline
CORS_DOMAIN=http://localhost:5173

CENTRIFUGO_ADDR=http://127.0.0.1:8000/api
CENTRIFUGO_KEY=baseline-only-not-secret

LOG_TO_FILE=false
LOG_FILENAME=baseline-server.log
MAX_BODY_BYTES=104857600
